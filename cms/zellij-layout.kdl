layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }

    tab name="martyrio-cms" focus=true {
        pane split_direction="vertical" {
            pane name="Database" {
                command "pnpm"
                args "db"
            }
            pane split_direction="vertical" {
                pane name="Payload CMS" focus=true {
                    command "pnpm"
                    args "dev:next"
                }
            }
        }
    }
}
