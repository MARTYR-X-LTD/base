---
import { getLiveEntry } from 'astro:content'
import Base from '@/layouts/Base.astro'

export const prerender = false

const { slug } = Astro.params
const isDraft = Astro.cookies.get('draft')?.value === 'true'
const { entry: work, error, cacheHint } = await getLiveEntry('works', { id: slug!, draft: isDraft })

if (error || !work) {
  return Astro.rewrite('/404')
}

if (cacheHint) Astro.cache.set(cacheHint)
Astro.cache.set({ maxAge: 31536000, swr: 3600, tags: [`work-${work.data.slug}`, 'works', 'categories'] })

const { title, category, mediaGallery, infoPanel } = work.data
---

<Base title={`${title} — mönk`}>
  <main>
    <article>
      <h1>{title}</h1>
      {category && <span class="category">{category.name}</span>}

      {mediaGallery?.items?.length > 0 && (
        <section class="gallery">
          <p>Gallery: {mediaGallery.items.length} items</p>
        </section>
      )}

      {infoPanel && infoPanel.length > 0 && (
        <aside class="info-panel">
          {infoPanel.map((block: any) => (
            <div class={`block-${block.blockType}`}>
              {block.blockType === 'info-item' && (
                <div>
                  <h3>{block.title}</h3>
                </div>
              )}
              {block.blockType === 'table' && (
                <dl>
                  {block.rows?.map((row: any) => (
                    <>
                      <dt>{row.label}</dt>
                      <dd>{/* Lexical render row.value */}</dd>
                    </>
                  ))}
                </dl>
              )}
            </div>
          ))}
        </aside>
      )}
    </article>
  </main>
</Base>

<style lang="scss">
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  article {
    h1 {
      margin-bottom: 0.5rem;
    }

    .category {
      display: inline-block;
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-bottom: 2rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .gallery {
      margin: 2rem 0;
      padding: 2rem;
      background: var(--surface-raised);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
    }

    .info-panel {
      margin-top: 2rem;
      padding: 1.5rem;
      background: var(--surface-raised);
      border: 1px solid var(--border);
      border-radius: 0.5rem;

      dl {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.5rem 1.5rem;

        dt {
          font-weight: 600;
          color: var(--text-muted);
        }
      }
    }
  }
</style>
