---
import { ClientRouter } from 'astro:transitions'
import { SEO } from 'astro-seo'
import UmamiOptOut from '@/components/Scripts/UmamiOptOut.astro'

// SCSS imports — order matters for @layer cascade
import '@/styles/_layers.scss'
import '@/styles/_reset.scss'
import '@/styles/_colors.scss'
import '@/styles/_base.scss'
import '@/styles/utilities.scss'

interface Props {
  title: string
  description?: string
  image?: string
  noindex?: boolean
}

const { title, description, image, noindex = false } = Astro.props
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.href}
      openGraph={{
        basic: {
          title,
          type: 'website',
          image: image ?? '',
        },
      }}
      noindex={noindex}
    />
    {/* Umami opt-out: ?umami=off to disable tracking, ?umami=on to re-enable */}
    <UmamiOptOut />
    {/* Umami analytics — natively tracks SPA navigation via pushState/popState */}
    {
      import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
        <script
          is:inline
          defer
          src="https://pulse.o3.malejandro.com/script.js"
          data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
        />
      )
    }
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <slot />
  </body>
</html>
