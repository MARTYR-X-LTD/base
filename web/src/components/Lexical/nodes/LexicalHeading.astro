---
import type { SerializedHeadingNode } from '@payloadcms/richtext-lexical'
import type { LexicalNode } from '@types/lexical'
import LexicalRenderer from '@components/Lexical/LexicalRenderer.astro'

interface Props {
  node: SerializedHeadingNode
}

const { node } = Astro.props
const Tag = `h${node.tag || 2}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6'
---

<Tag><LexicalRenderer nodes={node.children} /></Tag>
