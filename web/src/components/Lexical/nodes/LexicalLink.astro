---
import type { LinkFields } from '@types/lexical'
import type { SerializedLinkNode } from '@payloadcms/richtext-lexical'
import type { LexicalNode } from '@types/lexical'
import LexicalRenderer from '@components/Lexical/LexicalRenderer.astro'

interface Props {
  node: SerializedLinkNode & { fields: LinkFields }
}

const { node } = Astro.props

// Fields are in node.fields, not directly on node
const url = node.fields?.url ?? '#'
const newTab = node.fields?.newTab ?? false
---

<a
  href={url}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener noreferrer' : undefined}
><LexicalRenderer nodes={node.children as LexicalNode[]} /></a>
