---
import type { SerializedTextNode } from '@payloadcms/richtext-lexical'
import { TEXT_FORMAT } from '@/types/lexical'

interface Props {
  node: SerializedTextNode
}

const { node } = Astro.props

const format = node.format ?? 0
const text = node.text ?? ''

// Check each format bit
const isBold = (format & TEXT_FORMAT.BOLD) !== 0
const isItalic = (format & TEXT_FORMAT.ITALIC) !== 0
const isStrikethrough = (format & TEXT_FORMAT.STRIKETHROUGH) !== 0
const isUnderline = (format & TEXT_FORMAT.UNDERLINE) !== 0
const isCode = (format & TEXT_FORMAT.CODE) !== 0
const isSubscript = (format & TEXT_FORMAT.SUBSCRIPT) !== 0
const isSuperscript = (format & TEXT_FORMAT.SUPERSCRIPT) !== 0

// Build HTML with nested tags for multiple formats
function wrapText(content: string): string {
  let result = content

  // Code is mutually exclusive with other inline formats
  if (isCode) {
    return `<code>${result}</code>`
  }

  // Apply formats from innermost to outermost
  if (isSuperscript) result = `<sup>${result}</sup>`
  if (isSubscript) result = `<sub>${result}</sub>`
  if (isStrikethrough) result = `<s>${result}</s>`
  if (isUnderline) result = `<u>${result}</u>`
  if (isItalic) result = `<em>${result}</em>`
  if (isBold) result = `<strong>${result}</strong>`

  return result
}

const html = wrapText(text)
---

<Fragment set:html={html} />
