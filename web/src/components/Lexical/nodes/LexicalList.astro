---
import type { SerializedListNode, SerializedListItemNode } from '@payloadcms/richtext-lexical'
import type { LexicalNode } from '@/types/lexical'
import LexicalRenderer from '@/components/Lexical/LexicalRenderer.astro'

interface Props {
  node: SerializedListNode | SerializedListItemNode
}

const { node } = Astro.props

// Determine if this is a list container or list item
const isListContainer = 'tag' in node || 'listType' in node
const Tag =
  'tag' in node
    ? node.tag
    : 'listType' in node && node.listType === 'number'
      ? 'ol'
      : 'ul'
---

{
  isListContainer ? (
    <Tag><LexicalRenderer nodes={node.children as LexicalNode[]} /></Tag>
  ) : (
    <li><LexicalRenderer nodes={node.children as LexicalNode[]} /></li>
  )
}
