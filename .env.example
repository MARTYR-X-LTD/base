# ─── CMS ───────────────────────────────────────────────────────────────────────

# Database
DATABASE_URI=postgres://postgres:password@localhost:5432/monk-cms

# Payload
PAYLOAD_SECRET=your-secret-here
CMS_PORT=3000

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=martyr-media
# R2_PREFIX=monk # DEV
R2_PREFIX=monk-test # PROD
R2_PUBLIC_URL=https://media.martyr.shop

# Storage adapter (set to "local" for local development without R2)
# STORAGE_ADAPTER=local

# Production (for clone-prod-db.sh)
PROD_SSH_HOST=
PROD_DATABASE_URI=

# ─── WEB ───────────────────────────────────────────────────────────────────────

# Payload CMS (must match CMS_PORT above for local dev)
CMS_API_URL=http://localhost:3000/api
CMS_API_KEY=your-read-only-api-key

# Preview
PREVIEW_SECRET=your-preview-secret

# ─── SHARED ────────────────────────────────────────────────────────────────────

# Cache purge (must match between CMS and web)
PURGE_SECRET=your-shared-purge-secret
FRONTEND_PURGE_URL=https://monk.dev/api/cache/purge
